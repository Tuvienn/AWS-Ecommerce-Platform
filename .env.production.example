# Mẫu cấu hình production cho EC2 + RDS + S3.
# Copy thành .env trên EC2, thay toàn bộ giá trị YOUR_* bằng giá trị thật.
# Không commit file .env thật hoặc bất kỳ access key/password nào.

APP_NAME="AWS E-Commerce Platform"
APP_ENV=production
APP_KEY=YOUR_GENERATED_APP_KEY
APP_DEBUG=false
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_URL=http://YOUR_STAGING_EC2_PUBLIC_IP

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=YOUR_RDS_ENDPOINT
DB_PORT=3306
DB_DATABASE=aws_ecommerce_laravel_staging
DB_USERNAME=YOUR_RDS_USERNAME
DB_PASSWORD=YOUR_RDS_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=YOUR_STAGING_EC2_PUBLIC_IP

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=file

# Catalog image: chỉ đổi thành s3 sau Change 4, khi đã cài flysystem S3,
# tạo bucket và gắn IAM role cho EC2.
FILESYSTEM_DISK=local
CATALOG_DISK=s3
CATALOG_MAX_IMAGES_PER_PRODUCT=10
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=YOUR_S3_BUCKET
AWS_BUCKET_PREFIX=laravel-staging
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
CATALOG_TEMPORARY_URL_MINUTES=30

# VietQR demo/manual. Không đưa thông tin tài khoản thật vào Git.
VIETQR_IMAGE_BASE_URL=https://img.vietqr.io/image
VIETQR_BANK_CODE=YOUR_BANK_CODE
VIETQR_ACCOUNT_NO=YOUR_ACCOUNT_NUMBER
VIETQR_ACCOUNT_NAME=YOUR_ACCOUNT_NAME
VIETQR_TEMPLATE=compact2
