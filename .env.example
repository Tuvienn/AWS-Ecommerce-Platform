# Application environment: local | production
APP_ENV=local

# Application URL and base path.
# Leave APP_BASE_PATH empty when running directly from the document root.
APP_URL=http://127.0.0.1:8000
APP_BASE_PATH=
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Local MySQL connection.
# Production credentials must be provided through environment variables
# and must never be committed to the repository.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=webbanhang
DB_USER=root
DB_PASSWORD=

# Application log path.
LOG_PATH=storage/logs/application.log

# Runtime storage: local | s3.
# Never commit AWS credentials.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=storage/uploads
STORAGE_PUBLIC_BASE_URL=

AWS_REGION=
S3_BUCKET=
S3_PREFIX=
S3_PRIVATE=1
