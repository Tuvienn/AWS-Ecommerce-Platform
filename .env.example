APP_NAME="AWS E-Commerce Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_URL=http://127.0.0.1:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aws_ecommerce_laravel
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8000,localhost:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CATALOG_DISK=public
CATALOG_MAX_IMAGES_PER_PRODUCT=10
QUEUE_CONNECTION=database

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production dùng IAM role. Không commit access key vào file .env.
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_BUCKET_PREFIX=
AWS_USE_PATH_STYLE_ENDPOINT=false
CATALOG_TEMPORARY_URL_MINUTES=30

# VietQR cho môi trường local/demo. Không commit số tài khoản production.
VIETQR_IMAGE_BASE_URL=https://img.vietqr.io/image
VIETQR_BANK_CODE=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
VIETQR_TEMPLATE=compact2

VITE_APP_NAME="${APP_NAME}"
